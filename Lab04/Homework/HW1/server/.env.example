# Copy this file to server/.env and fill in real values. Never commit server/.env.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/lab04_hw

# Optional, used only by `npm run test:api` (set it in your shell; the tests do not read server/.env).
# The database name MUST end with _test. Default: mongodb://127.0.0.1:27017/lab04_hw_test
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/lab04_hw_test
